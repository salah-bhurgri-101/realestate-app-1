#!/bin/bash
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
echo '${dockerhub_token}' | docker login --username '${dockerhub_username}' --password-stdin || true
docker rm -f aurelia-${role} 2>/dev/null || true

# Named Docker volume per role: survives `docker rm -f` (which every
# (re)start above runs) and container replacement. It does NOT survive the
# underlying EC2 instance being replaced -- for that, attach a dedicated EBS
# volume and bind-mount it at this same path instead.
case '${role}' in
  auth-db) docker run -d --restart unless-stopped --name aurelia-auth-db -e POSTGRES_DB=authdb -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD='${auth_password}' -v aurelia_auth_db_data:/var/lib/postgresql/data -p ${host_port}:5432 ${image} ;;
  user-db) docker run -d --restart unless-stopped --name aurelia-user-db -e POSTGRES_DB=user_service_db -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD='${user_password}' -v aurelia_user_db_data:/var/lib/postgresql/data -p ${host_port}:5432 ${image} ;;
  audit-db) docker run -d --restart unless-stopped --name aurelia-audit-db -e POSTGRES_DB=auditdb -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD='${audit_password}' -v aurelia_audit_db_data:/var/lib/postgresql/data -p ${host_port}:5432 ${image} ;;
  property-db) docker run -d --restart unless-stopped --name aurelia-property-db -e MYSQL_ROOT_PASSWORD='${mysql_password}' -e MYSQL_DATABASE=propertydb -e MYSQL_USER=user -e MYSQL_PASSWORD='${property_password}' -v aurelia_property_db_data:/var/lib/mysql -p ${host_port}:3306 ${image} ;;
  redis) docker run -d --restart unless-stopped --name aurelia-redis -p ${host_port}:6379 ${image} redis-server --requirepass '${redis_password}' ;;
esac
